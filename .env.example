# ================= Docker Compose 部署配置 =================
# 使用方法：cp .env.example .env && 修改下方配置 && docker compose up -d --build

# ---------- MySQL ----------
# 两种用法（都在本 .env 里配置，无需改 docker-compose.yml）：
#   1) 本地/演示：用自带 mysql 容器 → DB_HOST=mysql，然后 docker compose --profile local-db up -d
#   2) 生产：用外部 MySQL → 把下面 DB_HOST 改成外部库地址，按需改 DB_PORT / DB_USER / DB_PASSWORD / DB_NAME，
#      然后 docker compose up -d backend web（不启动自带 mysql 容器）
#
# ===== 生产（外部 MySQL）示例：把这几行改成你的实际值即可 =====
DB_HOST=mysql            # 外部 MySQL 主机：域名 / IP / 同网络服务名（如 1panel-network 上的 mysql 容器名）
DB_PORT=3306             # 外部 MySQL 端口（非 3306 时修改）
DB_NAME=feedback         # 数据库名（需已存在，或由初始化账号建库）
DB_USER=feedback         # 应用连接账号
DB_PASSWORD=feedback123  # 应用连接密码（初始化也默认用这同一份账号密码，无需 root）
# ======================================================================

# 自带 mysql 容器相关（仅本地/演示用，生产可整段删除）
MYSQL_ROOT_PASSWORD=root123456
MYSQL_PORT=3308          # 本机映射端口，避免与本机已装 3306 冲突

# ---------- 初始化账号（init-db.js 建库/迁移）----------
# 【默认留空 = 直接用「应用账号 DB_USER/DB_PASSWORD」初始化，无需 root】
#   绝大多数托管/生产 MySQL 的应用账号本身已具备建库建表权限，直接用同一份账号密码即可。
# 仅以下例外需要显式设置：
#   A) 本地自带 mysql 容器（普通账号无建库权限）：INIT_DB_USER=root（用容器 root 建库）
#   B) 应用账号无建库权限、需由高权限账号建库：INIT_DB_USER=你的高权限主账号
#      （其密码用 INIT_DB_PASSWORD；若与 MYSQL_ROOT_PASSWORD 相同可不单独设，脚本会自动回退用 INIT_ROOT_PASSWORD）
# 若 DBA 已预先建好库 + 应用账号并授权：设 INIT_SKIP_USER=1（跳过建账号/授权步骤）
INIT_DB_USER=
INIT_DB_PASSWORD=
INIT_SKIP_USER=

# ---------- 安全（必须修改为随机长串！） ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-random-32bytes-hex
EMBED_SECRET=change-me-to-random-32bytes-hex
# 内置管理员账号（首次启动自动创建，部署完直接登录）
ADMIN_EMAIL=admin@feedback.local
ADMIN_PASSWORD=admin123456

# ---------- 对外地址 ----------
# 单域名/本地：WEB_BASE_URL 与 PUBLIC_BASE_URL 填同一个地址即可（如 http://localhost:8081）
#
# PUBLIC_BASE_URL = 后端对外的公开基址（必填准确！）。
#   用途：① 附件/图片绝对 URL 的兜底拼接；② embed / 邮件链接。
#   分域名部署时必须填 API 域名，如 https://api.example.com。
#   注意：附件 URL 现在会优先用「请求进来的对外域名」自动拼接（反代场景更准），
#        本变量作为兜底——当反代未透传 Host/X-Forwarded-Host 时靠它保证正确。
#        若填成 localhost / 内网地址且反代也没透传域名，图片仍会拼成错误地址。
PUBLIC_BASE_URL=http://localhost:8081
WEB_BASE_URL=http://localhost:8081

# ---------- 跨域 CORS ----------
# 后端默认允许所有来源（反射请求 Origin 并允许凭证），支持前后端分域名（feedback.example.com ↔ api.example.com）
# 以及客户把公开反馈页嵌入到自己任意域名。无需为跨域单独配置。

# ---------- 前端 API 地址（构建时注入，仅 web 镜像需要）----------
# 留空 = 使用相对路径 /api（由 web 的 nginx 反代到 backend，单域名部署用，无需配 CORS）
# 生产若 API 独立域名（如 https://api.example.com），填写它即可；后端默认允许所有来源，无需再配 CORS。
# 改完需重新构建 web 镜像：`docker compose build web && docker compose up -d web`
VITE_API_BASE_URL=
#
# ===== 生产（前端/API 分域名）示例：前端 feedback.example.com，API api.example.com =====
# PUBLIC_BASE_URL=https://api.example.com     # 后端公开基址（附件兜底、embed 等）
# WEB_BASE_URL=https://feedback.example.com            # 前端基址（CORS 默认已反射任意来源，无需用它驱动）
# VITE_API_BASE_URL=https://api.example.com/api   # 前端直连的 API 基地址（含 /api 前缀，构建时注入）
# 注：上传文件仍走相对 /uploads/（由 web 反代到 backend），无需额外配置；前后端两个域名各自配好反向代理即可。

# ---------- 端口 ----------
WEB_PORT=8081
BACKEND_PORT=4000
ADMINER_PORT=8088

# ---------- 文件存储 ----------
# local（默认，Docker 卷持久化）/ cos / oss
# cos / oss 密钥通过环境变量配置（见 server/src/services/storage.js）
STORAGE_DRIVER=local


# ---------- 服务 ----------
NODE_ENV=development
PORT=4000
API_PREFIX=/api
# 后端对外地址（生成附件/头像 URL 用）
PUBLIC_BASE_URL=http://localhost:4000
# 前端地址（CORS 白名单，多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173
WEB_BASE_URL=http://localhost:5173

# ---------- 数据库 ----------
# 本机 MySQL：DB_PORT=3306；Docker MySQL（docker-compose.yml）：DB_PORT=3307
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=feedback
DB_PASSWORD=feedback123
DB_NAME=feedback
DB_POOL_LIMIT=10
# 初始化脚本使用的 root 密码（npm run db:init）：INIT_ROOT_PASSWORD=your-root-pass

# ---------- 安全 ----------
# 生产环境务必替换：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-change-this-to-a-long-random-string-8f3a2c1e
JWT_EXPIRES_IN=7d
# 嵌入组件 / 公开接口签名密钥
EMBED_SECRET=please-change-embed-secret

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# 允许的图片类型
ALLOW_MIME=image/png,image/jpeg,image/gif,image/webp

# ---------- 文件存储 ----------
# 驱动选择：local（本地磁盘，默认）/ cos（腾讯云）/ oss（阿里云）
# 切换为 cos / oss 前需安装 SDK：npm install cos-nodejs-sdk ali-oss
STORAGE_DRIVER=local

# ---- 腾讯云 COS（STORAGE_DRIVER=cos 时生效）----
#COS_SECRET_ID=
#COS_SECRET_KEY=
#COS_BUCKET=your-bucket-1250000000
#COS_REGION=ap-guangzhou
#COS_PREFIX=feedback/
#COS_CDN_DOMAIN=

# ---- 阿里云 OSS（STORAGE_DRIVER=oss 时生效）----
#OSS_ACCESS_KEY_ID=
#OSS_ACCESS_KEY_SECRET=
#OSS_BUCKET=your-bucket
#OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
#OSS_PREFIX=feedback/
#OSS_CDN_DOMAIN=

# ---------- 限流 ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# 匿名提交反馈限流（同一 IP 每分钟）
ANON_SUBMIT_MAX=5

# ---------- 邮件（可选，不配则只写日志不发信）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Feedback <no-reply@example.com>
